# ── API FastAPI (obligatorio en teléfono físico: IP de tu PC, misma Wi‑Fi) ──
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# ── Supabase Auth (login correo/contraseña): Project Settings → API ──
EXPO_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Maps (necesaria para ver mapa en Expo Go: Android e iOS; habilita Maps SDK for Android + iOS en GCP) ──
EXPO_PUBLIC_GOOGLE_MAPS_KEY=