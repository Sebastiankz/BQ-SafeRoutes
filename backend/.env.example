# Conexión a Supabase — Session Pooler, convertido a asyncpg
# Toma el string del Session Pooler de Supabase y reemplaza:
#   postgresql://  →  postgresql+asyncpg://
# Añade ?ssl=require al final (obligatorio para Supabase)
DATABASE_URL=postgresql+asyncpg://postgres.TUREF:TUPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?ssl=require

ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production

# Supabase (para Auth en fases posteriores)
SUPABASE_URL=https://TUREF.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_JWT_SECRET=tu_jwt_secret_aqui