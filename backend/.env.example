# Conexión a Supabase — Session Pooler, convertido a asyncpg
# Toma el string del Session Pooler de Supabase y reemplaza:
#   postgresql://  →  postgresql+asyncpg://
# Añade ?ssl=require al final (obligatorio para Supabase)
DATABASE_URL=

ENVIRONMENT=
SECRET_KEY=

# Supabase (Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=reportes-fotos

# CORS para dashboard web
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Sesión web en cookie httpOnly (refresh token)
AUTH_COOKIE_NAME=sr_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# Subida de imágenes
MAX_UPLOAD_IMAGE_BYTES=8388608