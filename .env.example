# ── Base de datos ──────────────────────────────────
# El backend usa SQLAlchemy síncrono (create_engine + Session). La URL debe usar el
# driver psycopg2, no asyncpg (si copias de Supabase, cambia el prefijo).
#
# Ejemplo (reemplaza postgres:// por postgresql+psycopg2:// si viene así):
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Si ves "Not IPv4 compatible", usa el Session pooler de Supabase y mantén +psycopg2.
#
# Alternativa: si prefieres dejar postgresql+asyncpg:// en la URL, instala asyncpg
# en el venv (`pip install asyncpg`). No mezcles sin motivo: o psycopg2 en la URL
# o asyncpg en la URL, según el paquete que instales.
#
# URL del proyecto (misma que en la app). Obligatoria si Supabase firma JWT con clave asimétrica (RS256).
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
DATABASE_URL=

# Solo si sigues usando Postgres local con Docker (desarrollo opcional):
POSTGRES_USER=saferoutes
POSTGRES_PASSWORD=saferoutes_dev
POSTGRES_DB=saferoutes
DB_PORT=5432

# ── Redis ─────────────────────────────────────────
REDIS_PORT=6379

# ── Backend ───────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development

# JWT con HS256 (legacy): JWT Secret del panel. Con RS256 (signing keys) basta SUPABASE_URL + JWKS.
# SUPABASE_JWT_SECRET=

# ── Firebase (semana 3-4) ─────────────────────────
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── IDEAM API (semana 3-4) ────────────────────────
# IDEAM_API_URL=
# IDEAM_API_KEY=
